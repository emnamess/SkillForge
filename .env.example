# Copier ce fichier en .env puis adapter les valeurs
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SITE_URL=http://127.0.0.1:8000

# Modération IA des messages : clé gratuite sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_REFLEXION=minimal
MODERATION_IA_ACTIVE=True

# ---------- Production uniquement (variables à saisir sur Railway, voir README) ----------
